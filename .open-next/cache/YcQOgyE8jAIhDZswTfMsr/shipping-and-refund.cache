rrentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-user h-5 w-5\" aria-hidden=\"true\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg></button><button class=\"text-gray-900 hover:text-brand-maroon transition-colors p-2 relative\"><span class=\"sr-only\">Cart</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-bag h-6 w-6\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"></path><path d=\"M3.103 6.034h17.794\"></path><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"></path></svg></button></div></div></div></nav><main class=\"flex-1 flex flex-col\"><div class=\"container mx-auto px-4 py-16 md:py-24 max-w-4xl\"><div class=\"text-center mb-12\"><h1 class=\"text-4xl md:text-5xl font-serif text-brand-maroon mb-4\">Shipping &amp; Refund Policy</h1><div class=\"h-1 w-24 bg-brand-gold mx-auto rounded-full\"></div></div><div class=\"bg-white p-8 md:p-12 shadow-sm border border-brand-gold/20 rounded-xl text-gray-800 leading-relaxed space-y-12 relative overflow-hidden\"><div class=\"absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-brand-gold/10 to-transparent -z-10 rounded-bl-full\"></div><div class=\"absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-tr from-brand-gold/10 to-transparent -z-10 rounded-tr-full\"></div><div><div class=\"flex items-center gap-4 mb-6\"><div class=\"p-3 bg-brand-bg rounded-full border border-brand-gold/30 shadow-sm\"><svg class=\"w-6 h-6 text-brand-gold\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4\"></path></svg></div><h2 class=\"text-3xl font-serif text-brand-maroon m-0\">Shipping Policy</h2></div><div class=\"space-y-4 text-gray-700 ml-2 md:ml-16 border-l-2 border-brand-gold/20 pl-6 py-2\"><p class=\"text-lg\">At <strong>Jewel Palace</strong>, we ensure that your luxury imitation jewellery reaches you safely and promptly.</p><ul class=\"space-y-3 mt-4\"><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Delivery Area:</strong> We offer standard delivery across India.</span></li><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Processing Time:</strong> Orders are processed within 24-48 hours of confirmation.</span></li><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Delivery Time:</strong> Standard delivery takes <strong class=\"text-brand-maroon\">5-7 business days</strong> across India.</span></li><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Tracking:</strong> Once your order is dispatched, you will receive a tracking link via email or SMS.</span></li></ul></div></div><div class=\"w-full h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent my-8\"></div><div><div class=\"flex items-center gap-4 mb-6\"><div class=\"p-3 bg-brand-bg rounded-full border border-brand-gold/30 shadow-sm\"><svg class=\"w-6 h-6 text-brand-gold\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z\"></path></svg></div><h2 class=\"text-3xl font-serif text-brand-maroon m-0\">Refund &amp; Return Policy</h2></div><div class=\"space-y-4 text-gray-700 ml-2 md:ml-16 border-l-2 border-brand-gold/20 pl-6 py-2\"><p class=\"text-lg\">We take utmost care in packaging our products to ensure they arrive in pristine condition. However, if you receive a damaged item, we are here to help.</p><ul class=\"space-y-3 mt-4\"><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Return Window:</strong> We offer a strict <strong class=\"text-brand-maroon\">7-day return policy</strong> from the date of delivery.</span></li><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Eligibility:</strong> Returns are accepted <strong class=\"text-brand-maroon border-b border-brand-maroon/30\">for damaged items only</strong>. We do not accept returns for change of mind.</span></li><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Process:</strong> To initiate a return, please contact our support team within 48 hours of delivery with unboxing videos and clear photographs of the damage.</span></li><li class=\"flex items-start\"><span class=\"text-brand-gold mr-2\">•</span><span><strong>Refunds:</strong> Once the damaged item is received and inspected, we will process your refund to the original payment method within 5-7 business days.</span></li></ul></div></div><div class=\"mt-12 bg-brand-bg/50 p-6 md:p-8 rounded-xl border border-brand-gold/20 text-center shadow-sm\"><h3 class=\"text-xl font-serif text-brand-maroon mb-2\">Need Assistance?</h3><p class=\"text-gray-600 mb-4\">For any queries regarding your order, visit our store or contact us:</p><address class=\"not-italic text-gray-800\"><strong class=\"text-brand-maroon block mb-1\">Jewel Palace</strong>G-77, Moksh Plaza, Jambli Gali,<br/>Borivali West, Mumbai.<br/><br/><strong>Phone:</strong> +91 90299 23215<br/><strong>Email:</strong> <a href=\"mailto:praveensipani215@gmail.com\" class=\"text-brand-maroon hover:underline\">praveensipani215@gmail.com</a></address></div></div></div><!--$--><!--/$--></main><footer class=\"bg-[#1c1917] text-[#fffbf2] border-t bord